<UserControl x:Class="LostAndFound.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="数据备份"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="应用每天首次启动自动备份，自动备份保留最近 7 份。"
                               Margin="0,5,0,0"
                               Style="{DynamicResource MutedTextStyle}" />
                    <TextBlock x:Name="LatestBackupText"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="立即备份"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="CreateBackupButton_Click" />
                    <Button Content="恢复所选备份"
                            Style="{DynamicResource DangerButtonStyle}"
                            Click="RestoreButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{DynamicResource CardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="本地备份文件"
                           Margin="22,18,22,12"
                           Style="{DynamicResource SectionTitleStyle}" />
                <DataGrid x:Name="BackupsGrid"
                          Grid.Row="1"
                          BorderThickness="0,1,0,0"
                          SelectionChanged="BackupsGrid_SelectionChanged"
                          AutomationProperties.Name="备份文件列表">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                        <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="95" />
                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedText}" Width="155" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText"
                           Grid.Row="2"
                           Margin="22,12"
                           Text="还没有备份文件。"
                           Style="{DynamicResource MutedTextStyle}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
