<UserControl x:Class="LostAndFound.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border MinHeight="184"
                    Margin="0,0,0,20"
                    Padding="30,24"
                    Background="{DynamicResource HeroBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="GreetingText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="HeadlineText"
                                   Margin="0,8,0,0"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   MaxWidth="680" />
                        <TextBlock x:Name="DescriptionText"
                                   Margin="0,11,0,0"
                                   MaxWidth="650"
                                   FontSize="14"
                                   LineHeight="23"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="28,0,0,0"
                                VerticalAlignment="Center">
                        <Button x:Name="PrimaryActionButton"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                MinWidth="142"
                                Margin="0,0,0,10"
                                Click="PrimaryAction_Click" />
                        <Button Content="浏览失物广场"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                MinWidth="142"
                                Click="BrowseAction_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl x:Name="MetricsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,14,20"
                                Padding="18"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Caption}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Margin="0,5,8,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           FontSize="29"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,16,0"
                        Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="最新公开信息"
                                       Style="{DynamicResource SectionTitleStyle}" />
                            <Button Content="查看全部"
                                    HorizontalAlignment="Right"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Cursor="Hand"
                                    Click="BrowseAction_Click" />
                        </Grid>
                        <ItemsControl x:Name="RecentPostingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="8,3"
                                                    Margin="0,0,12,0"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="7"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Meta}"
                                                           Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyRecentText"
                                   Text="暂时没有公开信息。"
                                   Margin="0,14,0,0"
                                   Style="{DynamicResource MutedTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="进行中的认领"
                                   Style="{DynamicResource SectionTitleStyle}"
                                   Margin="0,0,0,14" />
                        <ItemsControl x:Name="ActiveClaimsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyClaimsText"
                                   Text="还没有进行中的认领。"
                                   Style="{DynamicResource MutedTextStyle}" />
                        <Button Content="前往消息中心"
                                Margin="0,14,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="MessagesAction_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
