<UserControl x:Class="LostAndFound.Desktop.Views.MyPostingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="发布记录"
                           Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="查看审核状态和驳回原因，所有记录仅本人可见。"
                           Margin="0,4,0,0"
                           Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Click="RefreshButton_Click" />
                <Button Content="发布新信息"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Click="CreateButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.75*" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PostingsGrid"
                              BorderThickness="0"
                              SelectionChanged="PostingsGrid_SelectionChanged"
                              AutomationProperties.Name="我的发布记录">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="75" />
                            <DataGridTextColumn Header="物品名称" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="95" />
                            <DataGridTextColumn Header="提交时间" Binding="{Binding CreatedText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText"
                               Grid.Row="1"
                               Margin="20,12"
                               Text="你还没有发布信息。"
                               Style="{DynamicResource MutedTextStyle}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <StackPanel x:Name="EmptyDetail"
                                VerticalAlignment="Center"
                                Margin="12">
                        <TextBlock Text="选择一条记录"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="这里会显示审核状态、管理员理由和完整内容。"
                                   Margin="0,7,0,0"
                                   Style="{DynamicResource MutedTextStyle}" />
                    </StackPanel>
                    <ScrollViewer x:Name="DetailPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailMeta"
                                       Margin="0,8,0,14"
                                       Style="{DynamicResource MutedTextStyle}" />
                            <Border Padding="11"
                                    Margin="0,0,0,14"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="9">
                                <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="物品描述"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="DetailDescription"
                                       FontSize="13"
                                       LineHeight="21" />
                            <TextBlock Text="审核说明"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,6" />
                            <TextBlock x:Name="ReviewReason"
                                       FontSize="13"
                                       LineHeight="21"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <WrapPanel Margin="0,20,0,0">
                                <Button x:Name="EditButton"
                                        Content="编辑信息"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Margin="0,0,10,8"
                                        Click="EditButton_Click" />
                                <Button x:Name="ResolveButton"
                                        Content="标记为已解决"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Margin="0,0,10,8"
                                        Click="ResolveButton_Click" />
                                <Button x:Name="CancelPostingButton"
                                        Content="撤销信息"
                                        Style="{DynamicResource DangerButtonStyle}"
                                        Margin="0,0,0,8"
                                        Click="CancelPostingButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
