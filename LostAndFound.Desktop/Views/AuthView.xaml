<UserControl x:Class="LostAndFound.Desktop.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="False">
    <Grid Background="{DynamicResource AuthBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="56,44,36,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="14">
                    <TextBlock Text="拾"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,2,0,0">
                    <TextBlock Text="校园失物招领"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Text="LOST &amp; FOUND"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        MaxWidth="620"
                        HorizontalAlignment="Left">
                <TextBlock Text="让每一次寻找，&#x0a;都有清晰的回应。"
                           FontSize="42"
                           FontWeight="SemiBold"
                           LineHeight="57"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Margin="0,20,0,0"
                           Text="发布失物与招领信息，发现关联线索，在匿名会话中安全沟通，并记录完整的认领过程。"
                           FontSize="16"
                           LineHeight="27"
                           MaxWidth="520"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <StackPanel Margin="0,32,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="✓" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="信息先审核，公开内容更可信" Margin="10,0,0,0"
                                   FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="✓" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="匿名沟通，真实信息仅用于争议处理" Margin="10,0,0,0"
                                   FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="24" Height="24" CornerRadius="12"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="✓" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="支持键盘、屏幕阅读器与高对比度" Margin="10,0,0,0"
                                   FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Height="140" Margin="0,28,40,0">
                <Ellipse Width="220" Height="110" Fill="{DynamicResource AccentSoftBrush}"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Border Width="132" Height="78" CornerRadius="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="54,0,0,22">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="最近公开记录" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="黑色雨伞 · 图书馆一楼"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Width="112" Height="92" CornerRadius="14"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="196,4,0,0">
                    <StackPanel Margin="14">
                        <TextBlock Text="找到啦" Foreground="{DynamicResource AccentTextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="每一步都有记录"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Opacity="0.8"
                                   FontSize="12"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Column="1"
                Width="430"
                Margin="32,46,64,46"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{DynamicResource CardStyle}"
                Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="FormHeading"
                               Text="欢迎回来"
                               FontSize="27"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="FormSubtitle"
                               Text="登录后继续发布、认领或管理信息。"
                               Margin="0,7,0,20"
                               Style="{DynamicResource MutedTextStyle}" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,22">
                    <Button x:Name="LoginTabButton"
                            Content="登录"
                            Style="{DynamicResource NavButtonStyle}"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="SemiBold"
                            Background="{DynamicResource AccentSoftBrush}"
                            Height="38"
                            Margin="0,0,4,0"
                            AutomationProperties.Name="切换到登录"
                            Click="LoginTab_Click" />
                    <Button x:Name="RegisterTabButton"
                            Content="注册"
                            Style="{DynamicResource NavButtonStyle}"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Background="Transparent"
                            Height="38"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="切换到普通用户注册"
                            Click="RegisterTab_Click" />
                </UniformGrid>

                <Grid Grid.Row="2">
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="校园卡号" FontSize="13" FontWeight="SemiBold" />
                        <TextBox x:Name="LoginCardNumber"
                                 Margin="0,7,0,14"
                                 TabIndex="0"
                                 AutomationProperties.Name="登录校园卡号"
                                 AutomationProperties.HelpText="输入六至二十四位校园卡号" />

                        <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold" />
                        <PasswordBox x:Name="LoginPassword"
                                     Margin="0,7,0,8"
                                     TabIndex="1"
                                     AutomationProperties.Name="登录密码"
                                     KeyDown="LoginPassword_KeyDown" />

                        <TextBlock x:Name="ErrorMessage"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   MinHeight="20"
                                   Margin="0,3,0,7"
                                   AutomationProperties.LiveSetting="Assertive" />

                        <Button x:Name="LoginButton"
                                Content="登录"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                IsDefault="True"
                                TabIndex="2"
                                Margin="0,2,0,12"
                                AutomationProperties.Name="登录"
                                Click="LoginButton_Click" />

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="游客浏览"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Margin="0,0,5,0"
                                    TabIndex="3"
                                    AutomationProperties.Name="以游客身份浏览"
                                    Click="GuestButton_Click" />
                            <Button x:Name="InitializeAdminButton"
                                    Grid.Column="1"
                                    Content="初始化管理员"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Margin="5,0,0,0"
                                    TabIndex="4"
                                    AutomationProperties.Name="初始化管理员账号"
                                    Click="InitializeAdminButton_Click" />
                        </Grid>

                        <TextBlock Text="演示账号请查看桌面上的 LostAndFound测试账号.txt"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <ScrollViewer x:Name="RegisterPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="校园卡号" FontSize="13" FontWeight="SemiBold" />
                            <TextBox x:Name="RegisterCardNumber"
                                     Margin="0,7,0,11"
                                     TabIndex="0"
                                     AutomationProperties.Name="注册校园卡号" />

                            <TextBlock Text="显示名称" FontSize="13" FontWeight="SemiBold" />
                            <TextBox x:Name="RegisterDisplayName"
                                     Margin="0,7,0,11"
                                     TabIndex="1"
                                     AutomationProperties.Name="注册显示名称" />

                            <TextBlock Text="联系方式" FontSize="13" FontWeight="SemiBold" />
                            <TextBox x:Name="RegisterContact"
                                     Margin="0,7,0,11"
                                     TabIndex="2"
                                     AutomationProperties.Name="注册联系方式" />

                            <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold" />
                            <PasswordBox x:Name="RegisterPassword"
                                         Margin="0,7,0,11"
                                         TabIndex="3"
                                         AutomationProperties.Name="注册密码"
                                         AutomationProperties.HelpText="密码至少八个字符" />

                            <TextBlock Text="确认密码" FontSize="13" FontWeight="SemiBold" />
                            <PasswordBox x:Name="ConfirmPassword"
                                         Margin="0,7,0,11"
                                         TabIndex="4"
                                         AutomationProperties.Name="确认注册密码" />

                            <CheckBox x:Name="PrivacyAccepted"
                                      Content="我已了解信息来源、用途和保存范围"
                                      Margin="0,2,0,10"
                                      TabIndex="5"
                                      AutomationProperties.Name="同意个人信息用途说明" />

                            <TextBlock x:Name="RegisterError"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       MinHeight="20"
                                       Margin="0,0,0,7"
                                       AutomationProperties.LiveSetting="Assertive" />

                            <Button x:Name="RegisterButton"
                                    Content="创建普通用户"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    TabIndex="6"
                                    Margin="0,0,0,10"
                                    AutomationProperties.Name="提交注册"
                                    Click="RegisterButton_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
