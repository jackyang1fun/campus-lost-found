<UserControl x:Class="LostAndFound.Desktop.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="待审核内容"
                           Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="审核通过后信息才会出现在公开列表中。"
                           Margin="0,4,0,0"
                           Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <Button Content="刷新队列"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.08*" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PendingGrid"
                              BorderThickness="0"
                              SelectionChanged="PendingGrid_SelectionChanged"
                              AutomationProperties.Name="待审核信息列表">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="72" />
                            <DataGridTextColumn Header="物品" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="105" />
                            <DataGridTextColumn Header="时间" Binding="{Binding CreatedText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText"
                               Grid.Row="1"
                               Margin="20,14"
                               Text="当前没有待审核信息，队列是空的。"
                               Style="{DynamicResource MutedTextStyle}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <StackPanel x:Name="EmptyDetail"
                                VerticalAlignment="Center"
                                Margin="14">
                        <TextBlock Text="选择一条待审核信息"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="右侧会显示完整描述、图片说明和联系方式。"
                                   Margin="0,7,0,0"
                                   Style="{DynamicResource MutedTextStyle}" />
                    </StackPanel>
                    <Grid x:Name="DetailPanel"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="DetailType"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="DetailTitle"
                                           Margin="0,8,0,10"
                                           FontSize="23"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailMeta"
                                           Style="{DynamicResource MutedTextStyle}"
                                           LineHeight="20" />
                                <Border Height="1"
                                        Margin="0,15"
                                        Background="{DynamicResource BorderBrush}" />
                                <TextBlock Text="物品描述"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <TextBlock x:Name="DetailDescription"
                                           FontSize="13"
                                           LineHeight="22" />
                                <Image x:Name="ReviewImage"
                                       Height="150"
                                       Margin="0,16,0,0"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed" />
                                <TextBlock Text="图片说明"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,6" />
                                <TextBlock x:Name="DetailImageAlt"
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Text="驳回理由（驳回时必填）"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBox x:Name="ReasonBox"
                                     Height="72"
                                     Margin="0,7,0,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     AutomationProperties.Name="驳回理由" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="审核通过"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        MinWidth="112"
                                        Margin="0,0,10,0"
                                        Click="ApproveButton_Click" />
                                <Button Content="驳回"
                                        Style="{DynamicResource DangerButtonStyle}"
                                        MinWidth="92"
                                        Click="RejectButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
