<UserControl x:Class="LostAndFound.Desktop.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.75*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="个人资料"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Text="联系方式不会出现在公开列表中。"
                                   Margin="0,5,0,18"
                                   Style="{DynamicResource MutedTextStyle}" />

                        <TextBlock Text="校园卡号"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="CampusCardText"
                                 Margin="0,7,0,14"
                                 IsReadOnly="True"
                                 AutomationProperties.Name="校园卡号，只读" />

                        <TextBlock Text="显示名称"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="DisplayNameBox"
                                 Margin="0,7,0,14"
                                 MaxLength="50"
                                 AutomationProperties.Name="显示名称" />

                        <TextBlock Text="联系方式"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="ContactBox"
                                 Margin="0,7,0,14"
                                 MaxLength="100"
                                 AutomationProperties.Name="联系方式" />

                        <TextBlock x:Name="ProfileStatusText"
                                   MinHeight="20"
                                   Foreground="{DynamicResource DangerBrush}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Content="保存个人资料"
                                Width="150"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="SaveProfileButton_Click" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="修改密码"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock Text="修改后请使用新密码登录。"
                                   Margin="0,5,0,18"
                                   Style="{DynamicResource MutedTextStyle}" />

                        <TextBlock Text="当前密码" FontSize="13" FontWeight="SemiBold" />
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Margin="0,7,0,13"
                                     AutomationProperties.Name="当前密码" />
                        <TextBlock Text="新密码" FontSize="13" FontWeight="SemiBold" />
                        <PasswordBox x:Name="NewPasswordBox"
                                     Margin="0,7,0,13"
                                     AutomationProperties.Name="新密码" />
                        <TextBlock Text="确认新密码" FontSize="13" FontWeight="SemiBold" />
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Margin="0,7,0,13"
                                     AutomationProperties.Name="确认新密码" />

                        <TextBlock x:Name="PasswordStatusText"
                                   MinHeight="20"
                                   Foreground="{DynamicResource DangerBrush}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button Content="更新密码"
                                Width="130"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="ChangePasswordButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Padding="24"
                        Background="{DynamicResource HeroBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <StackPanel>
                        <Border Width="62" Height="62"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="20">
                            <TextBlock x:Name="AvatarLetter"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="AccountNameText"
                                   Margin="0,14,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountRoleText"
                                   Margin="0,4,0,0"
                                   Style="{DynamicResource MutedTextStyle}" />
                        <Border Height="1"
                                Margin="0,20"
                                Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="个人信息只用于本地失物招领演示。管理员只有在处理争议时才能查看真实账号与联系方式。"
                                   FontSize="12"
                                   LineHeight="20"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DangerCard"
                        Margin="0,18,0,0"
                        Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="账号操作"
                                   FontWeight="SemiBold"
                                   FontSize="15" />
                        <TextBlock Text="注销后不能继续登录，历史记录会为争议追溯保留。"
                                   Margin="0,6,0,14"
                                   Style="{DynamicResource MutedTextStyle}" />
                        <Button Content="注销账号"
                                Style="{DynamicResource DangerButtonStyle}"
                                Click="DeactivateButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
