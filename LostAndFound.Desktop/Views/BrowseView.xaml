<UserControl x:Class="LostAndFound.Desktop.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,18"
                Padding="18"
                Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <TextBox x:Name="SearchBox"
                             AutomationProperties.Name="搜索关键词"
                             AutomationProperties.HelpText="按物品名称、地点或描述搜索公开信息"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索物品名称、地点或描述"
                               Margin="13,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               IsHitTestVisible="False" />
                </Grid>
                <ComboBox x:Name="CategoryBox"
                          Grid.Column="1"
                          Margin="0,0,12,0"
                          DisplayMemberPath="Name"
                          AutomationProperties.Name="物品分类筛选"
                          SelectionChanged="CategoryBox_SelectionChanged" />
                <Button Grid.Column="2"
                        Content="搜索"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="88"
                        Margin="0,0,10,0"
                        Click="SearchButton_Click" />
                <Button Grid.Column="3"
                        Content="刷新"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource CardStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,16,20,12">
                        <TextBlock Text="公开记录"
                                   Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock x:Name="ResultCountText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                    <DataGrid x:Name="PostingsGrid"
                              Grid.Row="1"
                              Margin="1,0,1,1"
                              BorderThickness="0,1,0,0"
                              SelectionChanged="PostingsGrid_SelectionChanged"
                              MouseDoubleClick="PostingsGrid_MouseDoubleClick"
                              AutomationProperties.Name="公开失物与招领信息列表">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="75" />
                            <DataGridTextColumn Header="物品名称" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="地点" Binding="{Binding Location}" Width="150" />
                            <DataGridTextColumn Header="发布时间" Binding="{Binding TimeText}" Width="115" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText"
                               Grid.Row="2"
                               Margin="20,12"
                               Text="没有找到符合条件的公开信息。"
                               Style="{DynamicResource MutedTextStyle}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource CardStyle}"
                    Padding="22">
                <Grid>
                    <StackPanel x:Name="EmptyDetailPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="320">
                        <Border Width="60" Height="60"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="20">
                            <TextBlock Text="⌕"
                                       FontSize="30"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="选择一条记录查看详情"
                                   Margin="0,16,0,6"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="你可以查看完整描述、基础关联候选，并在登录后发起认领。"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   LineHeight="20" />
                    </StackPanel>

                    <ScrollViewer x:Name="DetailScroll"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="TypeBadge"
                                    Padding="9,4"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="7">
                                <TextBlock x:Name="DetailType"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock x:Name="DetailTitle"
                                       Margin="0,12,0,8"
                                       FontSize="23"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailMeta"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       LineHeight="20" />
                            <Border Height="164"
                                    Margin="0,16,0,0"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="14"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="DetailImage"
                                           Stretch="UniformToFill"
                                           Visibility="Collapsed" />
                                    <StackPanel x:Name="FallbackArtwork"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="56"
                                                Height="56"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="28">
                                            <TextBlock x:Name="CategoryGlyph"
                                                       FontFamily="Segoe UI Emoji"
                                                       FontSize="30"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="CategoryArtworkLabel"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DetailDescription"
                                       Margin="0,16,0,0"
                                       FontSize="14"
                                       LineHeight="23" />
                            <TextBlock x:Name="ContactNotice"
                                       Margin="0,14,0,0"
                                       Text="联系方式不会公开展示，发起认领后请通过匿名会话沟通。"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />

                            <WrapPanel Margin="0,18,0,0">
                                <Button x:Name="ClaimButton"
                                        Content="发起认领"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Margin="0,0,10,8"
                                        Click="ClaimButton_Click" />
                                <Button Content="查找关联候选"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Margin="0,0,0,8"
                                        Click="FindMatchesButton_Click" />
                            </WrapPanel>

                            <Border x:Name="ClaimPanel"
                                    Margin="0,8,0,0"
                                    Padding="15"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="11"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="认领说明"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="请填写物品特征、遗失经过等能够证明归属的信息。说明仅认领双方和管理员可见。"
                                               Margin="0,5,0,9"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBox x:Name="ClaimStatementBox"
                                             Height="78"
                                             MaxLength="200"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             AutomationProperties.Name="认领说明"
                                             AutomationProperties.HelpText="填写十至两百个字符的物品特征或遗失经过" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="确认发起认领"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="SubmitClaimButton_Click" />
                                        <Button Content="取消"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Click="CancelClaimButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MatchesPanel"
                                    Margin="0,18,0,0"
                                    Padding="16"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="基础关联候选"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="结果只作提示，不会自动发起认领。"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,0,0,10" />
                                    <ItemsControl x:Name="MatchesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="11"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Reasons}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="忽略"
                                                                Tag="{Binding}"
                                                                IsEnabled="{Binding CanIgnore}"
                                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                                Margin="10,0,0,0"
                                                                Click="IgnoreMatchButton_Click" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoMatchesText"
                                               Text="暂时没有满足条件的基础关联候选。"
                                               Style="{DynamicResource MutedTextStyle}"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
