<UserControl x:Class="LostAndFound.Desktop.Views.AdminManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Columns="3">
            <Border Margin="0,0,12,0" Style="{DynamicResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="用户总数" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="UserCountText" FontSize="27"
                               FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Style="{DynamicResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="公开信息" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="PublicCountText" FontSize="27"
                               FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="待处理争议" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="DisputeCountText" FontSize="27"
                               FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="用户管理">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="0">
                        <DataGrid x:Name="UsersGrid"
                                  BorderThickness="0"
                                  SelectionChanged="UsersGrid_SelectionChanged"
                                  AutomationProperties.Name="用户列表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="校园卡号" Binding="{Binding CampusCardNumber}" Width="140" />
                                <DataGridTextColumn Header="联系方式" Binding="{Binding Contact}" Width="170" />
                                <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="85" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Style="{DynamicResource CardStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReasonBox"
                                     Margin="0,0,12,0"
                                     AutomationProperties.Name="用户状态变更原因"
                                     AutomationProperties.HelpText="封禁或停用用户时必填" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="封禁"
                                        Style="{DynamicResource DangerButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="BanButton_Click" />
                                <Button Content="恢复为正常"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Click="ActivateButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="内容管理">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="0">
                        <DataGrid x:Name="ContentGrid"
                                  BorderThickness="0"
                                  SelectionChanged="ContentGrid_SelectionChanged"
                                  AutomationProperties.Name="全部信息列表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="72" />
                                <DataGridTextColumn Header="物品" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="115" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedText}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Style="{DynamicResource CardStyle}"
                            Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DeleteReasonBox"
                                     Margin="0,0,12,0"
                                     AutomationProperties.Name="删除信息理由"
                                     AutomationProperties.HelpText="删除违规信息时必填" />
                            <Button Grid.Column="1"
                                    Content="删除所选信息"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    Click="DeletePostingButton_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="操作日志">
                <Border Margin="0,14,0,0"
                        Style="{DynamicResource CardStyle}"
                        Padding="0">
                    <DataGrid x:Name="AuditGrid"
                              BorderThickness="0"
                              AutomationProperties.Name="管理员操作日志">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="145" />
                            <DataGridTextColumn Header="操作者" Binding="{Binding Actor}" Width="115" />
                            <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="165" />
                            <DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="125" />
                            <DataGridTextColumn Header="原因/说明" Binding="{Binding Reason}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
