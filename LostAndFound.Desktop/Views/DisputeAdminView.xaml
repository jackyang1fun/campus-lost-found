<UserControl x:Class="LostAndFound.Desktop.Views.DisputeAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="争议处理"
                           Style="{DynamicResource SectionTitleStyle}" />
                <TextBlock Text="只有打开争议记录时，管理员才会看到双方真实身份和聊天内容，并写入审计日志。"
                           Margin="0,4,0,0"
                           Style="{DynamicResource MutedTextStyle}" />
            </StackPanel>
            <Button Content="刷新"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.82*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.18*" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DisputesGrid"
                              BorderThickness="0"
                              SelectionChanged="DisputesGrid_SelectionChanged"
                              AutomationProperties.Name="争议列表">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物品" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="110" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="95" />
                            <DataGridTextColumn Header="提交人" Binding="{Binding OpenedBy}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText"
                               Grid.Row="1"
                               Margin="18,12"
                               Text="当前没有争议记录。"
                               Style="{DynamicResource MutedTextStyle}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource CardStyle}">
                <Grid>
                    <StackPanel x:Name="EmptyDetail"
                                VerticalAlignment="Center"
                                Margin="12">
                        <TextBlock Text="选择一条争议"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="打开后会记录本次敏感信息访问。"
                                   Margin="0,7,0,0"
                                   Style="{DynamicResource MutedTextStyle}" />
                    </StackPanel>
                    <ScrollViewer x:Name="DetailPanel"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle"
                                       FontSize="23"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailMeta"
                                       Margin="0,7,0,14"
                                       Style="{DynamicResource MutedTextStyle}" />
                            <Border Padding="14"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="争议说明"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DisputeDescription"
                                               Margin="0,6,0,0"
                                               FontSize="13"
                                               LineHeight="21" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="13"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="发布者真实身份"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="PublisherIdentity"
                                                   Margin="0,6,0,0"
                                                   FontSize="13"
                                                   LineHeight="20" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2"
                                        Padding="13"
                                        Background="{DynamicResource SurfaceMutedBrush}"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="认领人真实身份"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock x:Name="InitiatorIdentity"
                                                   Margin="0,6,0,0"
                                                   FontSize="13"
                                                   LineHeight="20" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="相关聊天记录"
                                       Margin="0,18,0,7"
                                       FontWeight="SemiBold" />
                            <Border MaxHeight="220"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="MessagesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,3"
                                                           FontSize="12"
                                                           LineHeight="19" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Text="处理结论"
                                       Margin="0,16,0,6"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="ConclusionBox"
                                     Height="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     AutomationProperties.Name="争议处理结论" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="要求补充说明"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Margin="0,0,10,8"
                                        Click="NeedMoreButton_Click" />
                                <Button Content="关闭争议"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Margin="0,0,0,8"
                                        Click="CloseDisputeButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
