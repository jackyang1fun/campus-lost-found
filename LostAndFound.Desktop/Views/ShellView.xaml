<UserControl x:Class="LostAndFound.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="False">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,24,20,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38"
                                Background="{DynamicResource SidebarSelectedBrush}"
                                CornerRadius="11">
                            <TextBlock Text="拾"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SidebarTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="校园失物招领"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarTextBrush}" />
                            <TextBlock Text="LOST &amp; FOUND"
                                       FontSize="9"
                                       Foreground="{DynamicResource SidebarTextBrush}"
                                       Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavItems" Margin="14,0" />
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="14,12,14,18"
                        Padding="14"
                        Background="{DynamicResource SidebarSelectedBrush}"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock x:Name="SidebarUserName"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SidebarTextBrush}" />
                        <TextBlock x:Name="SidebarUserRole"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   Opacity="0.72" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="13,8"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="16">
                        <TextBlock x:Name="HeaderStatus"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Margin="30,26"
                            Focusable="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
