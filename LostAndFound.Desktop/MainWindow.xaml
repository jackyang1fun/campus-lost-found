<Window x:Class="LostAndFound.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="校园失物招领 · Lost and Found System"
        Width="1320"
        Height="720"
        MinWidth="1160"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ContentControl x:Name="RootHost"
                        Focusable="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <Grid x:Name="DialogLayer"
              Panel.ZIndex="20"
              Background="#990D1713"
              Visibility="Collapsed">
            <Border Width="440"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogMessage"
                               Margin="0,12,0,22"
                               FontSize="14"
                               LineHeight="23"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelButton"
                                Content="取消"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="DialogCancel_Click" />
                        <Button x:Name="DialogConfirmButton"
                                Content="确认"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="DialogConfirm_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="ToastPanel"
                Panel.ZIndex="30"
                MinWidth="280"
                MaxWidth="520"
                Margin="0,0,28,28"
                Padding="16,11"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="ToastMark"
                        Width="8"
                        Height="8"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="4" />
                <TextBlock x:Name="ToastText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
